{
  "name": "tienda-deportes",
  "private": true,
  "workspaces": ["backend", "frontend"],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev --workspace backend\" \"npm:dev --workspace frontend\"",
    "build": "npm run build --workspace backend && npm run build --workspace frontend",
    "test": "npm test --workspace backend",
    "test:unit": "npm run test:unit --workspace backend",
    "test:integration": "npm run test:integration --workspace backend",
    "db:migrate": "npm run db:migrate --workspace backend",
    "db:check": "npm run db:check --workspace backend",
    "admin:init": "npm run admin:init --workspace backend",
    "orders:expire": "npm run orders:expire --workspace backend"
  },
  "devDependencies": { "concurrently": "^9.2.1" }
}
